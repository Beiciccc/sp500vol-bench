writing/*/_minted-*/

# Cloud cost logs (may contain account-identifying info)
results/cost_logs/

# Local notes
NOTES.md
SCRATCH.md

# External reference data (L-M dictionary etc) — large, downloaded separately
data/external/

# SEC ticker cache (regenerable via universe.load_sec_ticker_map)
data/universe/sec_company_tickers.json

