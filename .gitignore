# Data — never commit raw EDGAR, market data, processed sets.
# Use /* so the directories themselves can hold a tracked .gitkeep.
data/raw/*
data/interim/*
data/market/*
data/processed/*
data/universe/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/market/.gitkeep
!data/processed/.gitkeep
!data/universe/.gitkeep
# Membership table is a core benchmark artifact — commit it (small).
!data/universe/README.md
!data/universe/sp500_membership.parquet
!data/universe/crsp_cik_links.parquet
!data/universe/sp500_membership_raw.csv
!data/universe/sp500_membership_raw_unresolved.csv
!data/universe/sp500_cik_candidates.csv
!data/universe/historical_cik_overrides.csv
# Sample data is small and committed for tests / spike
!data/sample/
!data/sample/**
!data/README.md

# Model checkpoints — too large
results/runs/*/checkpoints/
results/runs/*/*.ckpt
results/runs/*/*.pt
results/runs/*/*.bin
# neural model.pkl is GB-scale (C4 = 1.7G); never commit
results/runs/*/model.pkl
# but DO commit per-run metrics, predictions, configs
!results/runs/*/config.yaml
!results/runs/*/metrics.json
!results/runs/*/predictions.parquet
!results/runs/*/env.json

# Reference materials (Leeds templates, supervisor profile) — not part of code
Prepare/

