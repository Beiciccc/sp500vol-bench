{
  "dataset": "full",
  "disclosure": "long_form",
  "model": "B4_lm_features",
  "model_config": {
    "dictionary": {
      "csv_path": "./data/external/loughran_mcdonald.csv",
      "use_mock_if_missing": false
    },
    "engineered_features": [
      "log_token_count",
      "mean_word_length",
      "mean_sentence_length",
      "punctuation_density"
    ],
    "evaluation": {
      "per_disclosure_subset": true,
      "per_horizon": true
    },
    "model_class": "sp500vol.models.classical_text.lm_features.LMFeatures",
    "model_id": "B4_lm_features",
    "training": {
      "fit_per_horizon": true,
      "log_target": true,
      "ridge_alpha": null
    }
  },
  "seed": 2026
}
