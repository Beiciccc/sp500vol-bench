# Copy to .env and fill in real values. .env is gitignored.

# === SEC EDGAR ===
# Required by SEC: identify yourself in User-Agent header.
# Format: "Name email@domain.com"
EDGAR_USER_AGENT="Your Name your.email@example.com"

# === Market data ===
# Main benchmark source is WRDS CRSP, built once with scripts/ingest_wrds.py.
# No yfinance/Tiingo fallback is used in the current 2010-2025 S&P 500 scope.
MARKET_DATA_SOURCE="crsp"

# === Compute / cloud ===
# Optional: cloud provider tag for cost tracker
CLOUD_PROVIDER="vast.ai"
INSTANCE_TYPE="A100-80G"
HOURLY_RATE_USD="1.80"

# === Storage ===
# Root for large, regenerable data products: raw filings, parsed interim text,
# processed datasets, market caches. Read by sp500vol.utils.paths; defaults to
# <repo>/data. Point at an external drive (small internal disk) or a mounted
# bucket (cloud GPU) when the corpus won't fit alongside the code. In-repo
# inputs (data/universe membership table, data/external L-M dictionary) are
# never redirected.
SP500VOL_DATA_ROOT="/Volumes/Z/sp500vol-data"

# Optional: S3 / GCS bucket for cloud data freeze
# DATA_BUCKET="s3://sp500vol-data"

# === Experiment tracking (optional) ===
# WANDB_API_KEY=""
# WANDB_PROJECT="sp500vol"

# === Reproducibility ===
GLOBAL_SEED="2026"
